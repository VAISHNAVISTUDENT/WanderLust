<% layout("/layouts/boilerplate.ejs") %>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Create a New Listing</title>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  >

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
  </script>

  <style>

    #map {
      height: 400px;
      width: 100%;
      border-radius: 8px;
      margin-top: 10px;
    }

    #coordinates {
      margin-top: 10px;
      font-size: 14px;
      color: #555;
    }

    #locationStatus {
      margin-top: 8px;
      font-size: 14px;
    }

  </style>

</head>


<body>

  <div class="container">

    <h3>Create a New Listing</h3>


    <form
      method="POST"
      action="/listings"
      class="mt-4 needs-validation"
      novalidate
      enctype="multipart/form-data"
      id="listingForm"
    >


      <!-- TITLE -->

      <div class="mb-3">

        <label for="title" class="form-label">
          Title
        </label>

        <input
          name="listing[title]"
          class="form-control"
          id="title"
          placeholder="Enter title"
          type="text"
          required
        >

        <div class="invalid-feedback">
          Title is required.
        </div>

      </div>


      <!-- DESCRIPTION -->

      <div class="mb-3">

        <label for="description" class="form-label">
          Description
        </label>

        <textarea
          name="listing[description]"
          class="form-control"
          id="description"
          placeholder="Enter description"
          required
        ></textarea>

        <div class="invalid-feedback">
          Description is required.
        </div>

      </div>


      <!-- MULTIPLE IMAGES -->

      <div class="mb-3">

        <label for="images" class="form-label">
          Upload Images
        </label>

        <input
          name="listing[images]"
          class="form-control"
          id="images"
          type="file"
          accept="image/*"
          multiple
          required
        >

        <div class="form-text">
          You can select multiple images.
        </div>

        <div class="invalid-feedback">
          At least one image is required.
        </div>

      </div>


      <!-- IMAGE PREVIEW -->

      <div
        id="imagePreview"
        class="row g-3 mb-3"
      ></div>


      <!-- PRICE -->

      <div class="mb-3">

        <label for="price" class="form-label">
          Price
        </label>

        <input
          name="listing[price]"
          class="form-control"
          id="price"
          placeholder="Enter price"
          type="number"
          min="0"
          required
        >

        <div class="invalid-feedback">
          Price is required.
        </div>

      </div>


      <!-- COUNTRY -->

      <div class="mb-3">

        <label for="country" class="form-label">
          Country
        </label>

        <input
          name="listing[country]"
          class="form-control"
          id="country"
          placeholder="Enter country"
          type="text"
          required
        >

        <div class="invalid-feedback">
          Country is required.
        </div>

      </div>


      <!-- LOCATION -->

      <div class="mb-3">

        <label for="location" class="form-label">
          Location
        </label>

        <input
          name="listing[location]"
          class="form-control"
          id="location"
          placeholder="Enter location"
          type="text"
          required
        >

        <div class="invalid-feedback">
          Location is required.
        </div>

      </div>


      <!-- MAP -->

      <div class="mb-3">

        <label class="form-label">
          Choose Location on Map
        </label>

        <p class="text-muted mb-2">
          Click on the map to select the exact location of your listing.
        </p>

        <div id="map"></div>


        <div id="coordinates">
          No location selected.
        </div>


        <div
          id="locationStatus"
          class="text-danger"
        >
          Please select a location on the map.
        </div>

      </div>


      <!-- HIDDEN COORDINATES -->

      <input
        type="hidden"
        name="listing[latitude]"
        id="latitude"
      >

      <input
        type="hidden"
        name="listing[longitude]"
        id="longitude"
      >


      <!-- SUBMIT -->

      <button
        type="submit"
        class="btn btn-primary"
      >
        Add
      </button>

    </form>

  </div>


  <script>


    // =========================================
    // VARIABLES
    // =========================================

    const form = document.getElementById("listingForm");

    const latitudeInput =
      document.getElementById("latitude");

    const longitudeInput =
      document.getElementById("longitude");

    const locationStatus =
      document.getElementById("locationStatus");



    // =========================================
    // BOOTSTRAP VALIDATION
    // =========================================

    form.addEventListener("submit", function (event) {

      if (!form.checkValidity()) {

        event.preventDefault();
        event.stopPropagation();

        form.classList.add("was-validated");

        return;
      }


      // Make sure map location was selected

      if (
        latitudeInput.value === "" ||
        longitudeInput.value === ""
      ) {

        event.preventDefault();
        event.stopPropagation();

        locationStatus.textContent =
          "Please select a location on the map.";

        locationStatus.className =
          "text-danger";

        return;
      }


      locationStatus.textContent =
        "Location selected.";

      locationStatus.className =
        "text-success";

    });



    // =========================================
    // IMAGE PREVIEW
    // =========================================

    const imageInput =
      document.getElementById("images");

    const imagePreview =
      document.getElementById("imagePreview");


    imageInput.addEventListener("change", function () {

      imagePreview.innerHTML = "";

      const files = Array.from(this.files);


      files.forEach(function (file) {

        if (!file.type.startsWith("image/")) {
          return;
        }


        const reader = new FileReader();


        reader.onload = function (event) {

          const column =
            document.createElement("div");

          column.className =
            "col-md-3 col-sm-4 col-6";


          column.innerHTML = `
            <div class="card">

              <img
                src="${event.target.result}"
                class="card-img-top"
                style="
                  height: 180px;
                  object-fit: cover;
                "
              >

            </div>
          `;


          imagePreview.appendChild(column);

        };


        reader.readAsDataURL(file);

      });

    });



    // =========================================
    // LEAFLET MAP
    // =========================================

    // Start at India

    const map = L.map("map").setView(
      [20.5937, 78.9629],
      5
    );


    // OpenStreetMap tiles

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        attribution:
          '&copy; OpenStreetMap contributors'
      }
    ).addTo(map);


    let marker = null;



    // =========================================
    // MAP CLICK
    // =========================================

    map.on("click", function (event) {

      const latitude =
        event.latlng.lat;

      const longitude =
        event.latlng.lng;


      // Remove previous marker

      if (marker !== null) {

        map.removeLayer(marker);

      }


      // Create new marker

      marker = L.marker([
        latitude,
        longitude
      ])
      .addTo(map);


      marker
        .bindPopup("Selected location")
        .openPopup();


      // Store coordinates

      latitudeInput.value =
        latitude;

      longitudeInput.value =
        longitude;


      // Display coordinates

      document.getElementById(
        "coordinates"
      ).innerHTML = `
        <strong>Selected Coordinates:</strong><br>
        Latitude: ${latitude.toFixed(6)}<br>
        Longitude: ${longitude.toFixed(6)}
      `;


      // Update status

      locationStatus.textContent =
        "Location selected successfully.";

      locationStatus.className =
        "text-success";

    });

  </script>

</body>

</html>
